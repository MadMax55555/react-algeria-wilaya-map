{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "acme",
  "homepage": "https://acme.com",
  "items": [
    {
      "name": "vigilance-map",
      "type": "registry:component",
      "title": "Algeria Wilaya Vigilance Map",
      "description": "Interactive Algeria wilaya map with selection, colors, zoom, pan, controls, and a usage guide.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "card",
        "badge",
        "dialog"
      ],
      "files": [
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/components/vigilance-map.tsx",
          "type": "registry:component",
          "target": "components/ui/vigilance-map.tsx"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/components/map-guide-dialog.tsx",
          "type": "registry:component",
          "target": "components/ui/map-guide-dialog.tsx"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/data/algeria-wilayas.ts",
          "type": "registry:lib",
          "target": "lib/algeria-wilayas.ts"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/hooks/use-vigilance-map.ts",
          "type": "registry:hook",
          "target": "hooks/use-vigilance-map.ts"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/utils/vigilance-map.utils.ts",
          "type": "registry:lib",
          "target": "lib/vigilance-map.utils.ts"
        }
      ]
    }
  ]
}
