{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "acme",
  "homepage": "https://acme.com",
  "items": [
    {
      "name": "wilaya-map",
      "type": "registry:component",
      "title": "Algeria Wilaya Wilaya Map",
      "description": "Interactive Algeria wilaya map with selection, colors, zoom, pan, controls, and a usage guide.",
      "author": "Saadi Bella (https://github.com/MadMax55555)",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "button",
        "card",
        "badge",
        "dialog"
      ],
      "files": [
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/components/wilaya-map.tsx",
          "type": "registry:component",
          "target": "components/ui/wilaya-map.tsx"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/components/map-guide-dialog.tsx",
          "type": "registry:component",
          "target": "components/ui/map-guide-dialog.tsx"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/data/algeria-wilayas.ts",
          "type": "registry:lib",
          "target": "lib/algeria-wilayas.ts"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/hooks/use-wilaya-map.ts",
          "type": "registry:hook",
          "target": "hooks/use-wilaya-map.ts"
        },
        {
          "path": "registry/new-york/blocks/algeria-wilaya-map/utils/wilaya-map.utils.ts",
          "type": "registry:lib",
          "target": "lib/wilaya-map.utils.ts"
        }
      ]
    }
  ]
}
